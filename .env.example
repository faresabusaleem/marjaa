# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# Free Gemini API key from https://aistudio.google.com/apikey (only needed for
# MARJAA_LLM_PROVIDER=gemini, e.g. the hosted demo).
GEMINI_API_KEY=

# ollama (local, default) | gemini (free hosted API) | fake (tests)
MARJAA_LLM_PROVIDER=ollama
MARJAA_OLLAMA_MODEL=qwen3.5:4b
MARJAA_GEMINI_MODEL=gemini-3.5-flash-lite

# Which LLM grades answers in `make eval-answers`
MARJAA_JUDGE_PROVIDER=ollama
